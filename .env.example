# Copy to .env and fill in real values. .env is git- and docker-ignored.
# Generate a key with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"

DEBUG=0
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000

# Postgres is required whenever DEBUG=0.
POSTGRES_DB=quizops
POSTGRES_USER=quizops
POSTGRES_PASSWORD=
DATABASE_URL=postgres://quizops:CHANGE_ME@postgres:5432/quizops

# Redis: prefer HOST + PASSWORD so the app can URL-encode special characters.
# You may still set REDIS_URL / CELERY_* explicitly if you encode the password yourself.
REDIS_HOST=redis
REDIS_PASSWORD=
# REDIS_URL=
# CELERY_BROKER_URL=
# CELERY_RESULT_BACKEND=

# Set to 1 only behind a proxy that strips client-supplied forwarding headers.
TRUST_PROXY_SSL_HEADER=0
TRUST_X_FORWARDED_FOR=0
SECURE_SSL_REDIRECT=1

# Report unready when no Celery worker answers (compose sets this for web).
READYZ_REQUIRE_WORKER=0

# TOTP for org admins, platform operators, and Django staff/superusers.
# Defaults on when DEBUG=0.
MFA_REQUIRED=1
MFA_ISSUER_NAME=QuizOps
MFA_RATE_LIMIT=5
MFA_RATE_WINDOW_SECONDS=300

# Password reset needs a real backend in production.
# Local Compose staging: EMAIL_HOST=mailpit EMAIL_PORT=1025 EMAIL_USE_TLS=0
# (Mailpit UI at http://localhost:8025).
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=no-reply@example.com

# Local HTTP staging only — keep these at defaults (1) behind real TLS.
# SECURE_SSL_REDIRECT=0
# SESSION_COOKIE_SECURE=0
# CSRF_COOKIE_SECURE=0

LOG_LEVEL=INFO
SENTRY_DSN=
